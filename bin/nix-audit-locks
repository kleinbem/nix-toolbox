#!/usr/bin/env bash
# nix-audit-locks <flake-dir> <repo-dir>...: report drift between the revisions
# pinned in <flake-dir>/flake.lock and the git HEAD of each local repo dir
# (matched by basename against the flake's input names).
set -euo pipefail

if [ $# -lt 2 ]; then
    echo "usage: nix-audit-locks <flake-dir> <repo-dir>..." >&2
    exit 1
fi

# Resolve to an absolute path — a bare relative name like "nix-config" is
# parsed by `nix flake metadata` as a flake-registry shorthand, not a path,
# and fails with "cannot find flake 'flake:nix-config'".
flake_dir=$(realpath "$1")
shift

LOCKS=$(nix flake metadata --json "$flake_dir" | jq -c '.locks')

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

drift_count=0
for dir in "$@"; do
    name=$(basename "$dir")
    # rev-parse, not -d .git: worktrees and submodules have a .git file.
    if ! current=$(git -C "$dir" rev-parse HEAD 2>/dev/null); then
        printf "  %-20s %b(skipped: not a git repo)%b\n" "$name" "$YELLOW" "$RESET"
        continue
    fi

    # Input names map to node ids through the root node; a follows path is
    # walked from the root, and every follows edge on it is resolved the same way.
    locked=$(echo "$LOCKS" | jq -r --arg n "$name" '
        . as $l
        | def resolve($p): reduce $p[] as $i ($l.root;
              if . == null then null
              else $l.nodes[.].inputs[$i] as $e
                | if ($e | type) == "array" then resolve($e) else $e end
              end);
          ($l.nodes[$l.root].inputs[$n] // empty) as $e
        | (if ($e | type) == "array" then resolve($e) else $e end)
        | select(. != null)
        | $l.nodes[.].locked.rev // empty')
    if [ -z "$locked" ]; then
        printf "  %-20s %b(no lock entry — not a flake input?)%b\n" "$name" "$YELLOW" "$RESET"
        continue
    fi

    if [ "$locked" = "$current" ]; then
        printf "  %-20s %b✓ in sync%b  (%s)\n" "$name" "$GREEN" "$RESET" "${locked:0:12}"
    else
        printf "  %-20s %b⚠ DRIFT%b\n" "$name" "$RED" "$RESET"
        printf "    lock:  %s\n" "${locked:0:12}"
        printf "    head:  %s\n" "${current:0:12}"
        drift_count=$((drift_count + 1))
    fi
done

if [ "$drift_count" -gt 0 ]; then
    echo
    echo "ℹ  $drift_count drift(s) detected — update the lockfile to sync."
    exit 1
fi
