#!/usr/bin/env bash
# nix-check-lock [lock-path] [pgrep-pattern] — inspect a flock file (used by
# `just`/CI recipes to serialize long-running builds). Shows whether it's
# held and by what. Defaults match a typical Nix workspace build lock.
set -euo pipefail

LOCK="${1:-/tmp/workspace-just.lock}"
PATTERN="${2:-just|nixos-rebuild|nh os|nix build|nix eval}"

if [ ! -e "$LOCK" ]; then
    echo "✅ No active workspace lock found."
    exit 0
fi

# Try to take a non-blocking exclusive lock. If we can, nobody else holds it.
if flock -n "$LOCK" -c true 2>/dev/null; then
    echo "✅ Lock file exists but is NOT held by any active process."
else
    echo "🕵️  Workspace is LOCKED. Active tasks:"
    pgrep -af "$PATTERN" || true
fi
