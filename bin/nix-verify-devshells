#!/usr/bin/env bash
# nix-verify-devshells [flake-ref] — build every devShell a flake defines
# (introspected via `nix eval`, not a hardcoded list) for the current
# system, and report pass/fail per shell. Catches evaluation errors and
# missing dependencies. flake-ref defaults to ".".
#
# Deliberately no `set -e` — the contract is to attempt every shell and
# report all results, not bail on the first failure.

flake_ref="${1:-.}"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

CURRENT_SYSTEM=$(nix eval --raw --impure --expr 'builtins.currentSystem')

mapfile -t SHELLS < <(nix eval --json "${flake_ref}#devShells.${CURRENT_SYSTEM}" --apply builtins.attrNames 2>/dev/null | jq -r '.[]')

if [ "${#SHELLS[@]}" -eq 0 ]; then
    echo "No devShells found for ${flake_ref}#devShells.${CURRENT_SYSTEM}."
    exit 0
fi

echo -e "${YELLOW}🧪 Verifying DevShell Evaluation on ${CURRENT_SYSTEM}...${NC}"
echo "------------------------------------------------------------"
printf "%-15s | %-10s | %-30s\n" "Shell" "Status" "Details/Error"
echo "------------------------------------------------------------"

log=$(mktemp)
trap 'rm -f "$log"' EXIT

any_failed=0
for shell in "${SHELLS[@]}"; do
    if nix build "${flake_ref}#devShells.${CURRENT_SYSTEM}.${shell}" --no-link --print-build-logs >"$log" 2>&1; then
        printf "${GREEN}✅ %-13s${NC} | OK         | -\n" "$shell"
    else
        error=$(grep -E "error:" "$log" | head -n 1 | sed 's/error: //')
        [ -z "$error" ] && error="Evaluation failed (check build log)"
        printf "${RED}❌ %-13s${NC} | FAILED     | %-30s\n" "$shell" "$error"
        any_failed=1
    fi
done

echo "------------------------------------------------------------"
exit "$any_failed"
