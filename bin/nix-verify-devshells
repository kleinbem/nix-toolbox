#!/usr/bin/env bash
# nix-verify-devshells [flake-ref]: build every devShell the flake defines for
# the current system (default flake-ref "."), and report pass/fail per shell.
# No `set -e` on purpose: every shell is attempted and all results reported.

flake_ref="${1:-.}"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

CURRENT_SYSTEM=$(nix eval --raw --impure --expr 'builtins.currentSystem') || {
    echo "Could not determine the current system." >&2
    exit 1
}

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# No devShells for this system is an empty result; any other eval error (bad
# flake ref, broken flake) must fail, not pass as "no shells".
SHELLS=()
if names=$(nix eval --json "${flake_ref}#devShells.${CURRENT_SYSTEM}" --apply builtins.attrNames 2>"$log"); then
    names=$(jq -r '.[]' <<<"$names") || exit 1
    [ -n "$names" ] && mapfile -t SHELLS <<<"$names"
elif ! grep -q "does not provide attribute" "$log"; then
    cat "$log" >&2
    echo "Could not list ${flake_ref}#devShells.${CURRENT_SYSTEM}." >&2
    exit 1
fi

if [ "${#SHELLS[@]}" -eq 0 ]; then
    echo "No devShells found for ${flake_ref}#devShells.${CURRENT_SYSTEM}."
    exit 0
fi

echo -e "${YELLOW}🧪 Verifying DevShell Evaluation on ${CURRENT_SYSTEM}...${NC}"
echo "------------------------------------------------------------"
printf "%-15s | %-10s | %-30s\n" "Shell" "Status" "Details/Error"
echo "------------------------------------------------------------"

any_failed=0
for shell in "${SHELLS[@]}"; do
    if nix build "${flake_ref}#devShells.${CURRENT_SYSTEM}.${shell}" --no-link --print-build-logs >"$log" 2>&1; then
        printf "${GREEN}✅ %-13s${NC} | OK         | -\n" "$shell"
    else
        error=$(grep -E "error:" "$log" | head -n 1 | sed 's/error: //')
        [ -z "$error" ] && error="Evaluation failed (check build log)"
        printf "${RED}❌ %-13s${NC} | FAILED     | %-30s\n" "$shell" "$error"
        any_failed=1
    fi
done

echo "------------------------------------------------------------"
exit "$any_failed"
