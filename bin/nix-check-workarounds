#!/usr/bin/env bash
# nix-check-workarounds [--base <rev>] [--states] [dir] [-- <pathspec>...]
# Every workaround in a repo should link the upstream issue or PR it waits on,
# so it can be dropped when the fix arrives. This finds the ones that don't.
#
#   --base <rev>   only comment blocks touched since <rev> (a PR's check);
#                  default: every tracked file (an audit)
#   --states       look up each linked GitHub issue or PR with `gh` and list the
#                  merged or closed ones: their workaround can probably go
#   <pathspec>     limit the files (default: *.nix, shell, YAML, TOML, Python,
#                  justfiles)
#
# A workaround comment is a '#' block or trailing comment that says "workaround",
# "work around", "fixed upstream", "until upstream", "drop with/once/when",
# "remove once/when", "upstream bug/issue/fix" or "a PR will follow". It needs an
# http(s) link or an owner/repo#123 reference in the same block, or "no-link: <why>".
# Exit code 1 when one has no link, 2 on usage or git errors; --states only reports.
set -euo pipefail

BASE=""
STATES=0
DIR="."
PATHSPEC=()
need_value() { [ $# -ge 2 ] || { echo "$1 needs a value, see --help" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
    case "$1" in
    --base) need_value "$@"; BASE="$2"; shift 2 ;;
    --states) STATES=1; shift ;;
    -h | --help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; PATHSPEC=("$@"); break ;;
    *) DIR="$1"; shift ;;
    esac
done
if [ ${#PATHSPEC[@]} -eq 0 ]; then
    PATHSPEC=('*.nix' '*.sh' '*.bash' '*.yaml' '*.yml' '*.toml' '*.py' ':(icase)*justfile' '*.just')
fi

cd "$DIR"
cd "$(git rev-parse --show-toplevel)"

list=$(mktemp)
hunks=$(mktemp)
trap 'rm -f "$list" "$hunks"' EXIT
if [ -n "$BASE" ]; then
    git rev-parse -q --verify "$BASE^{commit}" >/dev/null || { echo "--base: unknown revision $BASE" >&2; exit 2; }
    git diff -z --name-only --diff-filter=d "$BASE" -- "${PATHSPEC[@]}" >"$list" || exit 2
else
    git ls-files -z -- "${PATHSPEC[@]}" >"$list" || exit 2
fi
files=()
while IFS= read -r -d '' f; do
    # Symlinks point at files checked in their own repo, and dangle in a lone clone.
    [ -f "$f" ] && [ ! -L "$f" ] && files+=("$f")
done <"$list"

if [ -n "$BASE" ] && [ ${#files[@]} -gt 0 ]; then
    : >"$hunks"
    for f in "${files[@]}"; do
        printf '\037%s\n' "$f" >>"$hunks"
        git diff -U0 --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ "$BASE" -- ":(literal)$f" >>"$hunks" || exit 2
    done
fi

# One line per workaround comment: file, line and links (space-separated),
# separated by \x1f, which no sane file name contains (a tab can).
scan() {
    awk -v use_hunks="${BASE:+1}" '
        use_hunks && NR == FNR {
            if (substr($0, 1, 1) == "\037") {
                curfile = substr($0, 2)
                in_del = 0
            } else if (curfile != "" && /^@@ / && match($0, /\+[0-9]+(,[0-9]+)? /)) {
                tok = substr($0, RSTART + 1, RLENGTH - 2)
                n = split(tok, parts, ",")
                hs = parts[1] + 0
                hc = (n > 1) ? (parts[2] + 0) : 1
                if (hc > 0) {
                    idx = ++h_n[curfile]
                    h_s[curfile, idx] = hs
                    h_e[curfile, idx] = hs + hc - 1
                    in_del = 0
                } else {
                    del_pos = hs
                    in_del = 1
                }
            } else if (in_del && /^-[[:space:]]*#/) {
                idx = ++h_n[curfile]
                h_s[curfile, idx] = del_pos
                h_e[curfile, idx] = del_pos + 1
                in_del = 0
            } else if (!/^-/) {
                in_del = 0
            }
            next
        }
        function in_hunks(file, s, e,    i, cnt) {
            if (!use_hunks) return 1
            cnt = h_n[file] + 0
            for (i = 1; i <= cnt; i++) {
                if (s <= h_e[file, i] && e >= h_s[file, i]) return 1
            }
            return 0
        }
        function in_arith(pre,    o, c) {
            o = gsub(/\(\(/, "", pre)
            c = gsub(/\)\)/, "", pre)
            return o > c
        }
        function flush() {
            text = tolower(block)
            gsub(/nix-check-workarounds/, "", text) # the tool name itself
            # Whole words only: "upstream fixtures" and "drop them with mkForce"
            # are no workarounds.
            if (block != "" && in_hunks(bfile, start, end) && text ~ /(^|[^a-z0-9_])(workarounds?|work around|fixed upstream|until upstream|drop (it |this )?with|drop (it |this |them )?(once|when)|remove (it |this )?(once|when)|upstream (bugs?|issues?|fix(es)?)|a pr will follow)([^a-z0-9_]|$)/) {
                links = ""
                rest = block
                while (match(rest, /https?:\/\/[^ )>"'\''`]+|[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+#[0-9]+/)) {
                    links = links (links == "" ? "" : " ") substr(rest, RSTART, RLENGTH)
                    rest = substr(rest, RSTART + RLENGTH)
                }
                if (tolower(block) ~ /no-link:[[:space:]]*[^[:space:]]/) links = "no-link"
                printf "%s\037%d\037%s\n", bfile, start, links
            }
            block = ""
        }
        FNR == 1 { flush(); heredoc = "" }
        FNR == 1 && /^#!/ { next }
        # Heredoc bodies are data (test fixtures), not comments.
        heredoc != "" { line = $0; sub(/^[[:space:]]+/, "", line); if (line == heredoc) heredoc = ""; next }
        /^[[:space:]]*#/ { if (block == "") { start = FNR; bfile = FILENAME }; end = FNR; block = block " " $0; next }
        { flush() }
        # A heredoc starts with <<WORD outside arithmetic: inside an open
        # $(( … the << is a shift.
        match($0, /<<-?[[:space:]]*["'\'']?[A-Za-z_][A-Za-z0-9_]*/) && !in_arith(substr($0, 1, RSTART - 1)) {
            heredoc = substr($0, RSTART, RLENGTH)
            gsub(/^<<-?[[:space:]]*["'\'']?/, "", heredoc)
        }
        # A trailing comment is its own block.
        /[[:space:]]#[[:space:]]/ { start = FNR; end = FNR; bfile = FILENAME; block = substr($0, index($0, " #")); flush() }
        END { flush() }
    ' "$@"
}

missing=0
found=""
if [ ${#files[@]} -gt 0 ]; then
    if [ -n "$BASE" ]; then
        found=$(scan "$hunks" "${files[@]}")
    else
        found=$(scan "${files[@]}")
    fi
fi

if [ -n "$found" ]; then
    while IFS=$'\x1f' read -r file line links; do
        if [ -z "$links" ]; then
            printf '%s:%s: workaround comment without a link\n' "$file" "$line"
            missing=$((missing + 1))
        fi
    done <<<"$found"
fi

if [ "$STATES" -eq 1 ] && [ -n "$found" ]; then
    command -v gh >/dev/null || { echo "--states needs gh" >&2; exit 2; }
    while IFS=$'\x1f' read -r file line links; do
        for url in $links; do
            if [[ $url =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]]; then
                url="https://github.com/${BASH_REMATCH[1]}/issues/${BASH_REMATCH[2]}"
            fi
            [[ $url =~ ^https://github\.com/[^/]+/[^/]+/(pull|issues)/[0-9]+ ]] || continue
            url=${BASH_REMATCH[0]}
            state=$(gh pr view "$url" --json state --jq .state 2>/dev/null ||
                gh issue view "$url" --json state --jq .state 2>/dev/null || echo "?")
            case "$state" in
            MERGED | CLOSED) printf '%s:%s: %s is %s; drop the workaround once the fix is in what we use\n' "$file" "$line" "$url" "$state" ;;
            "?") printf '%s:%s: %s: state unknown\n' "$file" "$line" "$url" ;;
            esac
        done
    done <<<"$found"
fi

total=0
[ -n "$found" ] && total=$(printf '%s\n' "$found" | wc -l)
echo "$total workaround comments, $missing without a link"
[ "$missing" -eq 0 ]
